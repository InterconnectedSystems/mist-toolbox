{
  "manifest_version": 3,
  "name": "Mist Toolbox",
  "version": "1.1.0",
  "description": "Read-only Juniper Mist and SSR reporting tools: disconnect RCA, SSID report, switch port inventory, IP/IRB blocks, Wi-Fi client export, and SSR pre/post change checks.",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Mist Toolbox",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "host_permissions": [
    "https://api.mist.com/*",
    "https://api.gc1.mist.com/*",
    "https://api.ac2.mist.com/*",
    "https://api.gc2.mist.com/*",
    "https://api.gc4.mist.com/*",
    "https://api.eu.mist.com/*",
    "https://api.gc3.mist.com/*",
    "https://api.ac6.mist.com/*",
    "https://api.gc6.mist.com/*",
    "https://api.ac5.mist.com/*",
    "https://api.gc5.mist.com/*",
    "https://api.gc7.mist.com/*",
    "https://api.us.mist-federal.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
